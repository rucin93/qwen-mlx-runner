{
  "$schema": "https://opencode.ai/config.json",
  "model": "qwen-metal/Qwen3.8-27B-4bit",
  "small_model": "qwen-metal/Qwen3.8-27B-4bit",
  "agent": {
    "title": { "disable": true }
  },
  "compaction": {
    "reserved": 1024
  },
  "provider": {
    "qwen-metal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen Metal",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3.8-27B-4bit": {
          "name": "Qwen3.8 27B",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "xhigh": { "reasoningEffort": "xhigh" }
          },
          "limit": {
            "context": 8192,
            "input": 8192,
            "output": 8192
          }
        }
      }
    }
  }
}
